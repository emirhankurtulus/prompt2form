# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/prompt2form?retryWrites=true&w=majority

# Auth (JWT)
JWT_SECRET=your-super-secret-256-bit-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AI — Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Storage — Vercel Blob
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token-here

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="Prompt2Form <noreply@prompt2form.com>"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth Integration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id-here.apps.googleusercontent.com
